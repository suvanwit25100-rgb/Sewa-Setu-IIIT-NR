# SewaSetu Next — environment variables (all optional; sensible defaults
# apply if unset). Copy to .env.local for local overrides. Never commit
# real secrets — this file only ever holds placeholders.

# --- Database -----------------------------------------------------------
# This prototype uses a file-based SQLite database (better-sqlite3), not a
# connection-string database — DATABASE_URL is kept here for contract
# parity with the spec, but nothing reads it today. The real override is
# SEWASETU_DB_DIR (used by the test suite to point at an isolated DB).
DATABASE_URL=file:./data/sewasetu.db
SEWASETU_DB_DIR=

# --- Auth (mock — see src/lib/auth.ts and /api/auth/login) --------------
# No JWT/bcrypt exists in this prototype (see README "Known limitations");
# JWT_SECRET is reserved for a future real-auth iteration.
JWT_SECRET=dev-only-placeholder-not-used

# --- AI -------------------------------------------------------------------
# mock = fully deterministic, offline, zero API calls (default, and the
# only mode actually implemented today — see src/lib/ai.ts).
AI_PROVIDER=mock
AI_API_KEY=

# --- Server -----------------------------------------------------------------
PORT=3000
CORS_ORIGIN=http://localhost:3000

NODE_ENV=development
